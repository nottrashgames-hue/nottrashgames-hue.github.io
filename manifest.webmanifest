{
  "name": "Bloodline",
  "short_name": "Bloodline",
  "description": "Bloodline - a WebXR sandbox",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#000000",
